# BioMentor Agent - Environment Variables
# 复制此文件为 .env.local 并填入真实值

# FastAPI 后端地址（部署到 Vercel 时必须配置为公网地址）
# 本地开发默认使用 http://127.0.0.1:9090
FASTAPI_BACKEND_URL=http://127.0.0.1:9090
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:9090

# DeepSeek API (用于工具箱、知识图谱、学术答辩与产业案例智能问答)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
